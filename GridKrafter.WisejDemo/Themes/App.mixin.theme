{
  "name": "App.mixin",
  "colors": {},
  "appearances": {
    "navbar-item": {
      "components": {
        "header": {
          "states": {
            "default": {
              "properties": {
                "textColor": "controlText",
                "backgroundColor": "transparent"
              }
            },
            "hovered": {
              "properties": {
                "textColor": "controlText",
                "backgroundColor": "controlDark"
              }
            },
            "selected": {
              "properties": {
                "textColor": "buttonSelectedText",
                "backgroundColor": "buttonSelected"
              },
              "styles": {
                "widthLeft": 3,
                "styleLeft": "solid",
                "colorLeft": "highlight"
              }
            }
          }
        }
      }
    },
    "segmentedbutton": {
      "states": {
        "default": {
          "properties": {
            "textColor": "windowText"
          }
        }
      },
      "components": {
        "row": {
          "states": {
            "default": {
              "properties": {
                "padding": 0,
                "backgroundColor": "transparent"
              }
            }
          }
        },
        "option": {
          "states": {
            "default": {
              "properties": {
                "textColor": "windowText",
                "backgroundColor": "window",
                "minHeight": 30,
                "padding": [
                  0,
                  12
                ],
                "margin": [
                  0,
                  6,
                  0,
                  0
                ]
              },
              "styles": {
                "width": 1,
                "style": "solid",
                "color": "windowFrame",
                "radius": 6
              }
            },
            "hovered": {
              "styles": {
                "color": "highlight"
              }
            },
            "focused": {
              "styles": {
                "color": "highlight",
                "shadowLength": 0,
                "shadowBlurRadius": 0
              }
            },
            "selected-raised": {
              "properties": {
                "backgroundColor": "highlight",
                "textColor": "highlightText"
              },
              "styles": {
                "color": "highlight",
                "shadowLength": 0,
                "shadowBlurRadius": 0
              }
            },
            "selected-pill": {
              "properties": {
                "backgroundColor": "highlight",
                "textColor": "highlightText"
              }
            },
            "selected-outlined": {
              "properties": {
                "backgroundColor": "highlight",
                "textColor": "highlightText"
              },
              "styles": {
                "color": "highlight"
              }
            }
          }
        }
      }
    },
    "navbar": {
      "states": {
        "default": {
          "properties": {
            "textColor": "controlText",
            "backgroundColor": "desktop"
          },
          "styles": {
            "widthRight": 1,
            "styleRight": "solid",
            "colorRight": "windowFrame"
          }
        }
      }
    },
    "navbar-menu": {
      "states": {
        "default": {
          "styles": {
            "backgroundColor": "desktop",
            "width": 1,
            "style": "solid",
            "color": "windowFrame"
          }
        }
      },
      "components": {
        "item": {
          "states": {
            "default": {
              "properties": {
                "textColor": "controlText"
              }
            },
            "selected": {
              "styles": {
                "backgroundColor": "buttonSelected"
              },
              "properties": {
                "textColor": "buttonSelectedText"
              }
            }
          },
          "components": {
            "icon": {
              "states": {
                "default": {
                  "properties": {
                    "textColor": "controlText"
                  }
                },
                "hovered": {
                  "properties": {
                    "textColor": "controlText"
                  }
                },
                "selected": {
                  "properties": {
                    "textColor": "buttonSelectedText"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}