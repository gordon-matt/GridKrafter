  "appearances": {
    "accordion": {
      "inherit": "panel",
      "components": {
        "panel": {
          "inherit": "panel",
          "states": {
            "default": {
              "styles": {
                "transform": "translateZ(0)",
                "transition": "top 200ms, height 200ms"
              }
            }
          },
          "components": {
            "open-button": {
              "inherit": "panel/close-button"
            },
            "icon": {
              "states": {
                "default": {
                  "properties": {
                    "marginLeft": 8,
                    "scale": true,
                    "width": 18,
                    "height": 18
                  }
                }
              }
            },
            "captionbar": {
              "text": "CaptionBar",
              "inherit": "panel/captionbar",
              "states": {
                "hovered": {
                  "properties": {
                    "cursor": "pointer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "alertbox": {
      "states": {
        "default": {
          "styles": {
            "width": 1,
            "color": "windowFrame",
            "backgroundColor": "white",
            "radius": "$borderRadius",
            "shadowBlurRadius": 20,
            "shadowColor": "buttonShadow",
            "shadowLength": 10
          },
          "properties": {
            "margin": 5,
            "textColor": "windowText",
            "minHeight": 50,
            "minWidth": 330,
            "width": 330,
            "maxWidth": 350
          }
        },
        "information": {
          "styles": {
            "backgroundColor": "info-soft",
            "color": "info-border"
          }
        },
        "error": {
          "styles": {
            "backgroundColor": "danger-soft",
            "color": "danger-border"
          }
        },
        "hand": {
          "styles": {
            "backgroundColor": "danger-soft",
            "color": "danger-border"
          }
        },
        "stop": {
          "styles": {
            "backgroundColor": "danger-soft"
          }
        },
        "warning": {
          "styles": {
            "backgroundColor": "warning-soft",
            "color": "warning-border"
          }
        },
        "question": {
          "styles": {
            "backgroundColor": "success-soft",
            "color": "success-border"
          }
        }
      },
      "components": {
        "dockingpane": {
          "states": {
            "default": {
              "properties": {
                "margin": 20
              }
            }
          }
        },
        "icon": {
          "states": {
            "default": {}
          }
        },
        "iconPane": {
          "states": {
            "default": {
              "styles": {
                "widthRight": 0
              },
              "properties": {
                "width": 0
              }
            }
          }
        },
        "message": {
          "states": {
            "default": {
              "properties": {
                "padding": 20,
                "textColor": "controlText"
              }
            }
          }
        },
        "close": {
          "states": {
            "default": {
              "properties": {
                "icon": "icon-close",
                "margin": [
                  0,
                  10,
                  0,
                  0
                ],
                "alignY": "middle",
                "cursor": "pointer"
              }
            }
          },
          "components": {
            "icon": {
              "inherit": "icon-dark",
              "states": {
                "default": {
                  "properties": {
                    "width": 24,
                    "height": 24,
                    "textColor": "gray-400"
                  }
                },
                "hovered": {
                  "properties": {
                    "textColor": "gray-200"
                  }
                }
              }
            }
          }
        },
        "progressbar": {
          "states": {
            "default": {
              "styles": {
                "backgroundColor": "info"
              },
              "properties": {
                "height": 0,
                "marginTop": -2,
                "zIndex": 11
              }
            },
            "information": {
              "styles": {
                "backgroundColor": "info"
              }
            },
            "error": {
              "styles": {
                "backgroundColor": "danger"
              }
            },
            "hand": {
              "styles": {
                "backgroundColor": "danger"
              }
            },
            "stop": {
              "styles": {
                "backgroundColor": "danger"
              }
            },
            "warning": {
              "styles": {
                "backgroundColor": "warning"
              }
            },
            "question": {
              "styles": {
                "backgroundColor": "success"
              }
            }
          }
        }
      }
    },
    "button": {
      "states": {
        "default": {
          "properties": {
            "opacity": 1,
            "center": true,
            "textColor": "buttonText",
            "height": 34
          },
          "styles": {
            "backgroundColor": "buttonFace",
            "color": "windowFrame",
            "radius": "$borderRadius",
            "transition": "background-color 200ms, border-color 200ms",
            "width": 1
          }
        },
        "hovered": {
          "styles": {
            "backgroundColor": "tint",
            "color": "primary"
          },
          "properties": {
            "cursor": "pointer"
          }
        },
        "focused": {
          "styles": {
            "color": "primary"
          }
        },
        "pressed": {
          "styles": {
            "backgroundColor": "buttonSelected",
            "color": "primary"
          },
          "properties": {
            "cursor": "pointer"
          }
        },
        "disabled": {
          "properties": {
            "opacity": 0.5,
            "cursor": "default",
            "textColor": "grayText"
          }
        },
        "checked": {
          "styles": {
            "backgroundColor": "primary",
            "gradientStart": [
              "primary",
              0
            ],
            "gradientEnd": [
              "secondary",
              1
            ],
            "color": "primary",
            "orientation": "horizontal"
          },
          "properties": {
            "textColor": "white"
          }
        },
        "borderNone": {
          "styles": {
            "width": 0
          }
