<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="xunit.v3" Version="4.0.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GridKrafter.Core\GridKrafter.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="System.Text.Json.Nodes" />
		<Using Include="GridKrafter" />
		<Using Include="GridKrafter.Layout" />
		<Using Include="GridKrafter.Localization" />
		<Using Include="GridKrafter.Models" />
		<Using Include="GridKrafter.Serialization" />
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
