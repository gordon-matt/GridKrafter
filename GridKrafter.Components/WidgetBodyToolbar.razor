@* A bar across the top of the body, under the header, for filters and actions. Use it anywhere inside a widget's body. *@
@if (Context is not null)
{
    <SectionContent SectionId="Context.BodyToolbarSlot">@ChildContent</SectionContent>
}

@code {
    /// <summary>
    /// Gets or sets what to show in the bar.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private WidgetContext? Context { get; set; }
}
