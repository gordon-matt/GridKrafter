@* Inline SVG, so widgets need no icon font or CDN on the host page. Anything that isn't a built-in name is treated as icon-font classes. *@
@if (Paths.TryGetValue(Name ?? string.Empty, out var paths))
{
    <svg class="gk-icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@paths</svg>
}
else if (!string.IsNullOrWhiteSpace(Name))
{
    <i class="gk-icon-font @Name @Class" aria-hidden="true"></i>
}

