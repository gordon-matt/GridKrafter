@* The dashboard with string and boolean parameters, for the custom element and MVC pages. *@
<div @ref="host" class="gk-element">
    @if (error is not null)
    {
        <div class="gk-root" data-theme="@Theme">
            <p class="gk-load-error" role="alert">@error</p>
        </div>
    }
    else
    {
        <Dashboard @ref="dashboard" Board="board" SavedBoard="saved" Widgets="catalog" Layouts="layouts"
                   EditMode="EditMode" EditModeChanged="OnEditModeChangedAsync" ReadOnly="ReadOnly" MoveWithoutEditMode="MoveWithoutEditMode"
                   Float="Float" RowHeight="RowHeight" Gap="Gap" Theme="@Theme" Language="@Language" StorageKey="@StorageKey"
                   ShowToolbar="ShowToolbar" DefaultButtons="defaultButtons" ButtonsOnHover="ButtonsOnHover" DefaultChrome="defaultChrome"
                   ConfirmDelete="ConfirmDelete" Class="@Class"
                   OnChanged="OnChangedAsync" OnLayoutChanged="OnLayoutChangedAsync" OnReady="OnReadyAsync"
                   OnRefresh="OnRefreshAsync" OnMountsChanged="OnMountsChangedAsync" />
    }
    @if (!string.IsNullOrEmpty(Name))
    {
        <input type="hidden" name="@Name" value="@boardJson" />
    }
</div>
