@* Content for the header, beside the title: badges, tabs, progress, buttons, pagers. Use it anywhere inside a widget's body. *@
@if (Context is not null)
{
    <SectionContent SectionId="Context.ToolbarSlot">@ChildContent</SectionContent>
}

@code {
    /// <summary>
    /// Gets or sets what to show in the header.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private WidgetContext? Context { get; set; }
}
