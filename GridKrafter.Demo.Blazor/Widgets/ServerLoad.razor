@inherits WidgetComponentBase

<ul class="gk-list">
    @foreach (var meter in meters)
    {
        <li>
            <Icon Name="@meter.Icon" Class="gk-muted" />
            <div class="demo-meter">
                <div class="demo-meter-label">
                    <span>@meter.Name</span>
                    <span class="gk-muted">@meter.Value%</span>
                </div>
                <div class="gk-progress @ToneOf(meter.Value)" style="--gk-value: @(meter.Value)%"
                     role="progressbar" aria-label="@meter.Name" aria-valuenow="@meter.Value" aria-valuemin="0" aria-valuemax="100">
                    <span></span>
                </div>
            </div>
        </li>
    }
</ul>

@code {
    private readonly Random random = new();
    private Meter[] meters =
    [
        new("CPU", "cpu", 42),
        new("Memory", "layers", 68),
        new("Disk", "box", 81),
        new("Network", "activity", 23),
    ];

    protected override Task OnRefreshAsync()
    {
        meters = [.. meters.Select(m => m with { Value = Math.Clamp(m.Value + random.Next(-12, 13), 3, 98) })];
        return Task.CompletedTask;
    }

    private static string ToneOf(int value) => value switch
    {
        >= 85 => "gk-color-red",
        >= 65 => "gk-color-amber",
        _ => "gk-color-green",
    };

    private sealed record Meter(string Name, string Icon, int Value);
}
